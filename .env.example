# App
APP_ENV=development
SEED_ENVIRONMENT_KEY=development
# Use 6123 if you use default Angular dev API URL (web/src/environments/environment.ts).
APP_PORT=6123
SERVER_LISTEN_TIMEOUT=10s

# TLS
USE_SSL=false
APP_BASE_DIR=
PATH_SSL_CERT=
PATH_SSL_KEY=


# After `make migrate` on an empty DB, migration `202605040002_bootstrap_dev_admin` may insert a dev user if the users table is still empty: email `admin@local`, password `admin` (skipped if any user exists).
#
# MySQL / MariaDB (e.g. /apps/services/compose.yml service `database`: root/root, port 3306)
# Create DB: mysql -h127.0.0.1 -uroot -proot -e "CREATE DATABASE IF NOT EXISTS flag_gen CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#
# DSN query params are parsed like a URL: "/" inside loc= breaks unless escaped as %2F.
# Use IANA names with exact casing (Asia/Jakarta → loc=Asia%2FJakarta). Avoid UTC+7 (+ becomes space); not a Go LoadLocation name anyway.
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/flag_gen?parseTime=true&loc=UTC
# Example Jakarta wall time: ...&loc=Asia%2FJakarta

# cmd/seed: If there are zero projects, creates SEED_PROJECT_KEY + SEED_ENVIRONMENT_KEY (+ demo segments/flags). Needs at least one user (e.g. migrate bootstrap admin). If the project exists but the env is missing, creates that env. If other projects already exist and SEED_* does not, uses the first project+environment in the DB.
# SEED_PROJECT_KEY=default
# SEED_ENVIRONMENT_KEY=production

# Redis (compose service `redis`: requirepass guest, port 6379)
REDIS_ADDR=127.0.0.1:6379
REDIS_ADDRS=
REDIS_FORCE_CLUSTER=false
REDIS_USERNAME=
REDIS_PASSWORD=guest
REDIS_DB=0

# RabbitMQ (compose: 5672; default user guest/guest from localhost)
RABBITMQ_AMQP_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=flaggen.events

# Webhooks (optional): receives committed flag outbox payloads after publish.
WEBHOOK_WORKER_ENABLED=false
WEBHOOK_URLS=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=5s

# Snapshots (use a writable path locally, e.g. /tmp/flag-gen-snapshot)
SNAPSHOT_DIR=/tmp/flag-gen-snapshot

# Required for /api CSRF when using the Angular app against this API
CSRF_SECRET=dev-csrf-secret-change-me

# Browser CORS (comma-separated). Required in production when APP_ENV=production (no localhost wildcard).
# Example: CORS_ALLOWED_ORIGINS=https://flags.example.com,https://admin.flags.example.com
CORS_ALLOWED_ORIGINS=
