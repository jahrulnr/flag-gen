# App
APP_ENV=development
APP_PORT=8080
SERVER_LISTEN_TIMEOUT=10s

# TLS
USE_SSL=false
APP_BASE_DIR=
PATH_SSL_CERT=
PATH_SSL_KEY=

# MySQL
# Example: user:pass@tcp(localhost:3306)/flag_gen?parseTime=true&loc=UTC
MYSQL_DSN=

# Redis
REDIS_ADDR=localhost:6379
REDIS_ADDRS=
REDIS_FORCE_CLUSTER=false
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Snapshots
SNAPSHOT_DIR=/app/snapshot

