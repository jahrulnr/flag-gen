# flag-gen API (same as repo root .env when using make dev)
FLAG_GEN_BASE_URL=http://localhost:6123/v1
# Project ID = UUID from dashboard (Projects list or API & SDK panel on Flags page)
FLAG_GEN_PROJECT_ID=
# Or resolve by human-readable project key (example helper only):
# FLAG_GEN_PROJECT_KEY=development
FLAG_GEN_ENVIRONMENT_KEY=development

# WebSocket auth (pick one):
# - Local dev: query token (matches flag-gen BROADCAST_DEV_TOKEN)
BROADCAST_DEV_TOKEN=dev-broadcast-token

# Optional: HTTP poll every 30s — fallback only when WebSocket/RabbitMQ is down (default off)
# FLAG_GEN_POLL_FALLBACK=false
# - Production-like: API key with broadcast:subscribe scope
FLAG_GEN_API_KEY=

# This sample HTTP server
EXAMPLE_HTTP_ADDR=:8080
